# Autenticação
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=123

# Configuração do n8n
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_TASK_TIMEOUT=900

# Python
N8N_PYTHON_INTERPRETER=/usr/local/bin/python3
N8N_PYTHON_INTERPRETER_PATH=/usr/bin/python3

# Bibliotecas permitidas
NODE_FUNCTION_ALLOW_EXTERNAL=mammoth
NODE_FUNCTION_ALLOW_BUILTIN=fs,path,http,https

# Armazenamento binário
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Banco MySQL
DB_TYPE=mysqldb
DB_MYSQLDB_HOST=mysql
DB_MYSQLDB_PORT=3306
DB_MYSQLDB_DATABASE=n8n
DB_MYSQLDB_USER=n8n_user
DB_MYSQLDB_PASSWORD=n8n_password
DB_MYSQLDB_ROOT_PASSWORD=n8n_password

